
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    parameters {
        booleanParam(
            name: 'FAULTY_RELEASE',
            defaultValue: false,
            description: 'Deploy a faulty release to test automatic rollback'
        )
    }

    environment {
        GIT_URL        = 'https://github.com/M123ukta/DevOps-Kuber2.git'
        DOCKERHUB_USER = 'muktamotwani'
        APP_DIR        = 'q1-lms-portal'
        APP_NAME       = 'lms-portal'
        IMAGE_REPO     = 'muktamotwani/lms-portal'
        VERSION        = "v${BUILD_NUMBER}"
    }

    stages {
        stage('Clone Code') {
            steps {
                echo 'Checking out source code from GitHub'
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'docker --version'
                        sh 'kubectl version --client'
                    } else {
                        bat 'docker --version'
                        bat 'kubectl version --client'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    script {
                        if (isUnix()) {
                            sh """
                                docker build \
                                  --build-arg APP_VERSION=${VERSION} \
                                  --build-arg FAULTY=${params.FAULTY_RELEASE} \
                                  -t ${IMAGE_REPO}:${VERSION} \
                                  -t ${IMAGE_REPO}:latest .
                            """
                        } else {
                            bat """
                                docker build --build-arg APP_VERSION=${VERSION} --build-arg FAULTY=${params.FAULTY_RELEASE} -t ${IMAGE_REPO}:${VERSION} -t ${IMAGE_REPO}:latest .
                            """
                        }
                    }
                }
            }
        }

        stage('Test Image') {
            steps {
                script {
                    if (isUnix()) {
                        sh "docker run --rm ${IMAGE_REPO}:${VERSION} nginx -t"
                        sh "docker run --rm ${IMAGE_REPO}:${VERSION} test -f /usr/share/nginx/html/index.html"
                    } else {
                        bat "docker run --rm ${IMAGE_REPO}:${VERSION} nginx -t"
                        bat "docker run --rm ${IMAGE_REPO}:${VERSION} test -f /usr/share/nginx/html/index.html"
                    }
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    script {
                        if (isUnix()) {
                            sh '''
                                set +x
                                echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                                docker push "$IMAGE_REPO:$VERSION"
                                docker push "$IMAGE_REPO:latest"
                            '''
                        } else {
                            bat '''
                                @echo off
                                echo %DH_TOKEN%| docker login -u %DH_USER% --password-stdin
                                if errorlevel 1 exit /b 1
                                docker push %IMAGE_REPO%:%VERSION%
                                if errorlevel 1 exit /b 1
                                docker push %IMAGE_REPO%:latest
                                if errorlevel 1 exit /b 1
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubeconfig',
                        variable: 'KCFG'
                    )
                ]) {
                    script {
                        if (isUnix()) {
                            sh '''
                                export KUBECONFIG="$KCFG"
                                kubectl apply -f "$APP_DIR/service.yaml"
                            '''
                        } else {
                            bat '''
                                @echo off
                                set "KUBECONFIG=%KCFG%"
                                kubectl apply -f "%APP_DIR%\\service.yaml"
                                if errorlevel 1 exit /b 1
                            '''
                        }

                        dir("${APP_DIR}") {
                            script {
                                def manifest = readFile('deployment.yaml')
                                    .replaceAll(
                                        /(?m)^(\s*image:\s*)\S+.*$/,
                                        '$1' + "${IMAGE_REPO}:${VERSION}"
                                    )

                                writeFile(
                                    file: 'deployment.rendered.yaml',
                                    text: manifest
                                )
                            }
                        }

                        if (isUnix()) {
                            sh '''
                                export KUBECONFIG="$KCFG"
                                kubectl apply -f "$APP_DIR/deployment.rendered.yaml"
                            '''
                        } else {
                            bat '''
                                @echo off
                                set "KUBECONFIG=%KCFG%"
                                kubectl apply -f "%APP_DIR%\\deployment.rendered.yaml"
                                if errorlevel 1 exit /b 1
                            '''
                        }
                    }
                }
            }
        }

        stage('Health Check & Auto Rollback') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubeconfig-creds',
                        variable: 'KCFG'
                    )
                ]) {
                    script {
                        try {
                            if (isUnix()) {
                                withEnv(["KUBECONFIG=${env.KCFG}"]) {
                                    sh "kubectl rollout status deployment/${APP_NAME} --timeout=60s"
                                }
                            } else {
                                bat """
                                    @echo off
                                    set "KUBECONFIG=%KCFG%"
                                    kubectl rollout status deployment/${APP_NAME} --timeout=60s
                                """
                            }

                            echo "Release ${VERSION} is healthy."
                        } catch (err) {
                            echo "Release ${VERSION} failed. Attempting rollback."

                            if (isUnix()) {
                                withEnv(["KUBECONFIG=${env.KCFG}"]) {
                                    sh "kubectl rollout undo deployment/${APP_NAME}"
                                    sh "kubectl rollout status deployment/${APP_NAME} --timeout=90s"
                                }
                            } else {
                                bat """
                                    @echo off
                                    set "KUBECONFIG=%KCFG%"
                                    kubectl rollout undo deployment/${APP_NAME}
                                    if errorlevel 1 exit /b 1
                                    kubectl rollout status deployment/${APP_NAME} --timeout=90s
                                    if errorlevel 1 exit /b 1
                                """
                            }

                            error("Release ${VERSION} failed. Rollback attempted.")
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    withCredentials([
                        file(
                            credentialsId: 'kubeconfig-creds',
                            variable: 'KCFG'
                        )
                    ]) {
                        if (isUnix()) {
                            withEnv(["KUBECONFIG=${env.KCFG}"]) {
                                sh "kubectl get pods -l app=${APP_NAME}"
                                sh "kubectl rollout history deployment/${APP_NAME}"
                            }
                        } else {
                            bat """
                                @echo off
                                set "KUBECONFIG=%KCFG%"
                                kubectl get pods -l app=${APP_NAME}
                                kubectl rollout history deployment/${APP_NAME}
                            """
                        }
                    }
                } catch (ignored) {
                    echo 'Kubernetes summary skipped.'
                }

                try {
                    if (isUnix()) {
                        sh 'docker logout'
                    } else {
                        bat 'docker logout'
                    }
                } catch (ignored) {
                    echo 'Docker logout skipped.'
                }
            }
        }

        success {
            echo "Release ${VERSION} deployed successfully."
            echo 'Application URL: http://localhost:30010'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs for the cause.'
        }
    }
}
