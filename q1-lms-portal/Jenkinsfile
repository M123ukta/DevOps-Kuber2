pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    parameters {
        booleanParam(
            name: 'FAULTY_RELEASE',
            defaultValue: false,
            description: 'Deploy a faulty release to test automatic rollback'
        )
    }

    environment {
        DOCKERHUB_USER = 'muktamotwani'
        APP_DIR        = 'q1-lms-portal'
        APP_NAME       = 'lms-portal'
        IMAGE_REPO     = 'muktamotwani/lms-portal'
        VERSION        = "v${BUILD_NUMBER}"
        APP_URL        = 'http://localhost:30010'
    }

    stages {
        stage('Clone Code') {
            steps {
                echo 'Checking out source code from GitHub'
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                bat 'docker --version'
                bat 'kubectl version --client'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    bat 'docker build --build-arg APP_VERSION=%VERSION% --build-arg FAULTY=%FAULTY_RELEASE% -t %IMAGE_REPO%:%VERSION% -t %IMAGE_REPO%:latest .'
                }
            }
        }

        stage('Test Image') {
            steps {
                script {
                    bat 'docker run --rm %IMAGE_REPO%:%VERSION% nginx -t'
                    bat 'docker run --rm %IMAGE_REPO%:%VERSION% test -f /usr/share/nginx/html/index.html'

                    if (!params.FAULTY_RELEASE) {
                        bat 'docker run --rm %IMAGE_REPO%:%VERSION% test -f /usr/share/nginx/html/health.html'
                        echo 'Healthy image checks passed.'
                    } else {
                        echo 'Fault injection enabled; health.html is intentionally removed.'
                    }
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    bat '''
                        @echo off
                        powershell -NoProfile -Command "$env:DH_TOKEN | docker login -u $env:DH_USER --password-stdin"
                        if errorlevel 1 exit /b 1
                        docker push %IMAGE_REPO%:%VERSION%
                        if errorlevel 1 exit /b 1
                        docker push %IMAGE_REPO%:latest
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubeconfig',
                        variable: 'KCFG'
                    )
                ]) {
                    script {
                        dir("${APP_DIR}") {
                            def manifest = readFile('deployment.yaml')

                            manifest = manifest.replaceAll(
                                /(?m)^(\s*image:\s*)\S+.*$/,
                                '$1' + env.IMAGE_REPO + ':' + env.VERSION
                            )

                            if (!manifest.contains("image: ${env.IMAGE_REPO}:${env.VERSION}")) {
                                error('Could not update the deployment image tag.')
                            }

                            writeFile(
                                file: 'deployment.rendered.yaml',
                                text: manifest
                            )
                        }

                        bat '''
                            @echo off
                            set "KUBECONFIG=%KCFG%"
                            kubectl apply -f "%APP_DIR%/service.yaml"
                            if errorlevel 1 exit /b 1
                            kubectl apply -f "%APP_DIR%/deployment.rendered.yaml"
                            if errorlevel 1 exit /b 1
                        '''
                    }
                }
            }
        }

        stage('Health Check and Auto Rollback') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubeconfig-creds',
                        variable: 'KCFG'
                    )
                ]) {
                    script {
                        try {
                            bat '''
                                @echo off
                                set "KUBECONFIG=%KCFG%"
                                kubectl rollout status deployment/%APP_NAME% --timeout=120s
                                if errorlevel 1 exit /b 1
                                powershell -NoProfile -ExecutionPolicy Bypass -Command "$r = Invoke-WebRequest -Uri '%APP_URL%' -UseBasicParsing; if ($r.StatusCode -ne 200 -or [string]::IsNullOrWhiteSpace($r.Content)) { exit 1 }"
                                if errorlevel 1 exit /b 1
                            '''

                            echo "Release ${VERSION} deployed and verified successfully."

                        } catch (err) {
                            echo "FAILED RELEASE DETECTED: ${VERSION}"
                            echo 'Attempting rollback to the previous release.'

                            bat '''
                                @echo off
                                set "KUBECONFIG=%KCFG%"
                                kubectl rollout undo deployment/%APP_NAME%
                                if errorlevel 1 exit /b 1
                                kubectl rollout status deployment/%APP_NAME% --timeout=120s
                                if errorlevel 1 exit /b 1
                                powershell -NoProfile -ExecutionPolicy Bypass -Command "$r = Invoke-WebRequest -Uri '%APP_URL%' -UseBasicParsing; if ($r.StatusCode -ne 200 -or [string]::IsNullOrWhiteSpace($r.Content)) { exit 1 }"
                                if errorlevel 1 exit /b 1
                            '''

                            echo 'ROLLBACK VERIFIED: the restored application responds successfully.'

                            if (params.FAULTY_RELEASE) {
                                currentBuild.result = 'UNSTABLE'
                                echo 'Expected faulty release was rejected and rollback succeeded.'
                            } else {
                                error("Release ${VERSION} failed. Rollback succeeded, but the normal release failed its health check.")
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    withCredentials([
                        file(
                            credentialsId: 'kubeconfig-creds',
                            variable: 'KCFG'
                        )
                    ]) {
                        bat '''
                            @echo off
                            set "KUBECONFIG=%KCFG%"
                            kubectl get pods -l app=%APP_NAME%
                            kubectl rollout history deployment/%APP_NAME%
                        '''
                    }
                } catch (ignored) {
                    echo 'Kubernetes summary skipped.'
                }

                try {
                    bat 'docker logout'
                } catch (ignored) {
                    echo 'Docker logout skipped.'
                }
            }
        }

        success {
            echo "Release ${VERSION} deployed successfully."
            echo "Application URL: ${APP_URL}"
        }

        unstable {
            echo 'Faulty-release test completed with rollback, or the build was otherwise marked unstable.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs for the cause.'
        }
    }
}
