// ---------------------------------------------------------------------------
// Q2 - Online Food Ordering Portal : automated testing + BLUE-GREEN deployment
// GitHub -> Jenkins -> Docker -> Docker Hub -> Kubernetes (Docker Desktop)
//
//   * Two Deployments: food-portal-blue and food-portal-green (3 pods each),
//     both rendered from the same deployment.yaml.
//   * food-portal-live    (NodePort 30020) -> the ACTIVE colour (real users).
//   * food-portal-preview (NodePort 30021) -> the IDLE colour (team validation).
//   * A new release is deployed ONLY to the idle colour. If it fails, the idle
//     colour is rolled back automatically and live traffic never moves.
//   * After validation (manual approval or AUTO_PROMOTE) live traffic is switched.
//     If the post-switch check fails, traffic is switched back automatically.
//
// Jenkins credentials (same as Q1):
//   docker     : Username with password  (Docker Hub user + access token)
//   kubeconfig : Secret file             (Docker Desktop kubeconfig)
// ---------------------------------------------------------------------------

// HTTP check from the Jenkins machine; retries for ~30s. Returns 0 on HTTP 200.
def httpCheck(String url) {
    return bat(returnStatus: true, script: """@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "for (\$i = 0; \$i -lt 10; \$i++) { try { \$r = Invoke-WebRequest -Uri '${url}' -UseBasicParsing -TimeoutSec 5; if (\$r.StatusCode -eq 200) { exit 0 } } catch {}; Start-Sleep -Seconds 3 }; exit 1"
""")
}

// Called when the new release fails on the idle colour.
def handleFailedRelease(String reason) {
    env.RELEASE_OK = 'false'
    echo "FAILED RELEASE DETECTED: ${env.VERSION} on ${env.IDLE} (${reason})"
    bat(returnStatus: true, script: '@echo off\nkubectl get pods -l app=food-portal,version=%IDLE%')

    echo "Rolling back food-portal-${env.IDLE} to its previous stable revision..."
    def rc = bat(returnStatus: true, script: '@echo off\nkubectl rollout undo deployment/food-portal-%IDLE%')
    if (rc == 0) {
        rc = bat(returnStatus: true, script: '@echo off\nkubectl rollout status deployment/food-portal-%IDLE% --timeout=120s')
    }
    if (rc == 0) {
        echo "ROLLBACK COMPLETE: food-portal-${env.IDLE} is back on its previous stable revision."
    } else {
        echo "food-portal-${env.IDLE} has no earlier stable revision; scaling it to 0."
        bat '@echo off\nkubectl scale deployment/food-portal-%IDLE% --replicas=0'
    }

    if (env.ACTIVE != 'none') {
        if (httpCheck("${env.LIVE_URL}/health.html") != 0) {
            error("Live site on ${env.ACTIVE} is not responding!")
        }
        echo "LIVE TRAFFIC UNAFFECTED: ${env.LIVE_URL} is still served by ${env.ACTIVE} and returns HTTP 200."
    } else {
        echo 'No previous live colour exists yet (first deployment).'
    }

    if (params.FAULTY_RELEASE) {
        currentBuild.result = 'UNSTABLE'
        echo 'Expected faulty release was rejected; previous stable version keeps serving users.'
    } else {
        error("Release ${env.VERSION} failed: ${reason}")
    }
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    parameters {
        booleanParam(name: 'FAULTY_RELEASE', defaultValue: false,
                     description: 'Deploy a deliberately faulty release (health.html removed) to demonstrate failure detection and rollback')
        booleanParam(name: 'AUTO_PROMOTE', defaultValue: false,
                     description: 'Skip manual approval and switch live traffic automatically once the preview passes')
    }

    environment {
        APP_DIR     = 'q2-food-portal'
        IMAGE_REPO  = 'muktamotwani/food-portal'
        VERSION     = "v${BUILD_NUMBER}"
        LIVE_SVC    = 'food-portal-live'
        PREVIEW_SVC = 'food-portal-preview'
        LIVE_URL    = 'http://localhost:30050'
        PREVIEW_URL = 'http://localhost:30051'
        TEST_PORT   = '18080'
        RELEASE_OK  = 'true'
        KUBECONFIG  = credentials('kubeconfig')
    }

    stages {
        stage('Clone Code') {
            steps {
                echo 'Checking out source code from GitHub'
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                bat 'docker --version'
                bat 'kubectl version --client'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    retry(3) {
                        bat 'docker build --build-arg APP_VERSION=%VERSION% --build-arg FAULTY=%FAULTY_RELEASE% -t %IMAGE_REPO%:%VERSION% .'
                    }
                }
            }
        }

        stage('Automated Tests') {
            steps {
                script {
                    // 1. Static checks inside the image
                    bat 'docker run --rm %IMAGE_REPO%:%VERSION% nginx -t'
                    bat 'docker run --rm %IMAGE_REPO%:%VERSION% test -s /usr/share/nginx/html/index.html'
                    bat 'docker run --rm %IMAGE_REPO%:%VERSION% test -s /usr/share/nginx/html/style.css'
                    bat 'docker run --rm %IMAGE_REPO%:%VERSION% grep -q %VERSION% /usr/share/nginx/html/index.html'

                    // 2. Run the container locally and request the page
                    bat '@echo off\ndocker rm -f food-test-%BUILD_NUMBER% >nul 2>&1\ndocker run -d --name food-test-%BUILD_NUMBER% -p %TEST_PORT%:80 %IMAGE_REPO%:%VERSION%'
                    try {
                        if (httpCheck("http://localhost:${env.TEST_PORT}/") != 0) {
                            error('Local container test failed: home page did not return HTTP 200.')
                        }
                        echo "Local container test passed on http://localhost:${env.TEST_PORT}"
                    } finally {
                        bat(returnStatus: true, script: '@echo off\ndocker rm -f food-test-%BUILD_NUMBER%')
                    }

                    // 3. Health endpoint (skipped for the deliberately faulty build)
                    if (!params.FAULTY_RELEASE) {
                        bat 'docker run --rm %IMAGE_REPO%:%VERSION% test -f /usr/share/nginx/html/health.html'
                        echo 'All automated tests passed.'
                    } else {
                        echo 'Fault injection enabled: health.html intentionally removed; Kubernetes readiness probe will reject it.'
                    }
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_TOKEN')]) {
                    script {
                        retry(3) {
                            bat '''
                                @echo off
                                powershell -NoProfile -Command "$env:DH_TOKEN | docker login -u $env:DH_USER --password-stdin"
                                if errorlevel 1 exit /b 1
                                docker push %IMAGE_REPO%:%VERSION%
                                if errorlevel 1 exit /b 1
                            '''
                        }
                        if (!params.FAULTY_RELEASE) {
                            bat 'docker tag %IMAGE_REPO%:%VERSION% %IMAGE_REPO%:latest'
                            retry(3) {
                                bat 'docker push %IMAGE_REPO%:latest'
                            }
                        } else {
                            echo 'Faulty release: not moving the latest tag.'
                        }
                    }
                }
            }
        }

        stage('Detect Active Colour') {
            steps {
                script {
                    def exists = bat(returnStatus: true, script: '@echo off\nkubectl get svc %LIVE_SVC% >nul 2>&1')
                    if (exists != 0) {
                        echo 'First deployment: creating live and preview Services. BLUE becomes the first live colour.'
                        bat 'kubectl apply -f "%APP_DIR%/service.yaml"'
                        env.ACTIVE = 'none'
                        env.IDLE   = 'blue'
                    } else {
                        env.ACTIVE = bat(returnStdout: true,
                                         script: '@echo off\nkubectl get svc %LIVE_SVC% -o jsonpath="{.spec.selector.version}"').trim()
                        env.IDLE   = (env.ACTIVE == 'blue') ? 'green' : 'blue'
                    }
                    echo "ACTIVE (serving users) = ${env.ACTIVE} | IDLE (new release goes here) = ${env.IDLE}"
                }
            }
        }

        stage('Deploy to Idle Colour') {
            steps {
                script {
                    dir("${APP_DIR}") {
                        def manifest = readFile('deployment.yaml')
                        manifest = manifest.replaceAll('(?m)^(\\s*image:\\s*)\\S+.*$',
                                                       '$1' + env.IMAGE_REPO + ':' + env.VERSION)
                        manifest = manifest.replaceAll('\\bblue\\b', env.IDLE)

                        if (!manifest.contains("image: ${env.IMAGE_REPO}:${env.VERSION}") ||
                            !manifest.contains("name: food-portal-${env.IDLE}")) {
                            error('Could not render deployment.yaml for the idle colour.')
                        }
                        writeFile(file: 'deployment.rendered.yaml', text: manifest)
                    }

                    bat '''
                        @echo off
                        kubectl apply -f "%APP_DIR%/deployment.rendered.yaml"
                        if errorlevel 1 exit /b 1
                        kubectl annotate deployment/food-portal-%IDLE% kubernetes.io/change-cause="Release %VERSION% (faulty=%FAULTY_RELEASE%)" --overwrite
                    '''

                    def rc = bat(returnStatus: true,
                                 script: '@echo off\nkubectl rollout status deployment/food-portal-%IDLE% --timeout=120s')
                    if (rc == 0) {
                        echo "Release ${env.VERSION} rolled out on ${env.IDLE}: 3/3 pods Ready."
                    } else {
                        handleFailedRelease('rollout did not complete - pods never became Ready')
                    }
                }
            }
        }

        stage('Validate on Preview') {
            when { expression { env.RELEASE_OK == 'true' } }
            steps {
                script {
                    bat 'kubectl set selector svc/%PREVIEW_SVC% app=food-portal,version=%IDLE%'
                    if (httpCheck("${env.PREVIEW_URL}/health.html") != 0 || httpCheck("${env.PREVIEW_URL}/") != 0) {
                        handleFailedRelease('preview smoke test failed')
                    } else {
                        echo "PREVIEW HEALTHY: open ${env.PREVIEW_URL} to inspect ${env.VERSION} on ${env.IDLE} before it goes live."
                    }
                }
            }
        }

        stage('Approve & Switch Traffic') {
            when { expression { env.RELEASE_OK == 'true' } }
            steps {
                script {
                    if (!params.AUTO_PROMOTE) {
                        timeout(time: 30, unit: 'MINUTES') {
                            input message: "Preview ${env.PREVIEW_URL} looks good? Switch live traffic to ${env.IDLE} (${env.VERSION})?",
                                  ok: 'Promote to live'
                        }
                    }
                    bat 'kubectl set selector svc/%LIVE_SVC% app=food-portal,version=%IDLE%'
                    echo "TRAFFIC SWITCHED: ${env.LIVE_URL} now served by ${env.IDLE} (${env.VERSION})."
                }
            }
        }

        stage('Post-Switch Verification') {
            when { expression { env.RELEASE_OK == 'true' } }
            steps {
                script {
                    if (httpCheck("${env.LIVE_URL}/health.html") == 0 && httpCheck("${env.LIVE_URL}/") == 0) {
                        echo "LIVE VERIFIED on ${env.IDLE}. ${env.ACTIVE} is kept running for instant rollback."
                    } else {
                        if (env.ACTIVE != 'none') {
                            bat 'kubectl set selector svc/%LIVE_SVC% app=food-portal,version=%ACTIVE%'
                            echo "AUTOMATIC ROLLBACK: live traffic switched back to ${env.ACTIVE}."
                        }
                        error("Live verification failed for ${env.VERSION}.")
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                bat(returnStatus: true, script: '''
                    @echo off
                    echo ===== Deployments =====
                    kubectl get deployments -l app=food-portal -o wide
                    echo ===== Pods =====
                    kubectl get pods -l app=food-portal -o wide
                    echo ===== Services =====
                    kubectl get svc -l app=food-portal
                    echo ===== Live service points to =====
                    kubectl get svc %LIVE_SVC% -o jsonpath="{.spec.selector.version}"
                    echo.
                    echo ===== Rollout history =====
                    kubectl rollout history deployment/food-portal-blue
                    kubectl rollout history deployment/food-portal-green
                ''')
                bat(returnStatus: true, script: 'docker logout')
            }
        }
        success  { echo "Release ${env.VERSION} is LIVE on ${env.IDLE}: ${env.LIVE_URL}" }
        unstable { echo "Faulty release ${env.VERSION} was rejected and rolled back. Users still served by ${env.ACTIVE}: ${env.LIVE_URL}" }
        failure  { echo 'Pipeline failed. Live traffic remains on the previous stable version.' }
    }
}